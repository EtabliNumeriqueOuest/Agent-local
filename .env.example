# Copie ce fichier en .env (jamais versionné). Aucune clé n'est nécessaire en mode hors ligne.

# Mode hors ligne (défaut) : faux modèle intégré, embeddings déterministes, recherche web fictive.
# 0 = vrai modèle local (models.yaml) et embeddings EmbeddingGemma (`make models-real`).
AGENT_LOCAL_OFFLINE=1

# Embeddings : hash (défaut hors ligne) | gemma
# AGENT_LOCAL_EMBEDDINGS=hash

# Dossier unique des données (bases SQLite, documents importés, modèles). Défaut : var/data
# AGENT_LOCAL_DATA_DIR=var/data

# Port d'écoute (toujours sur 127.0.0.1).
# AGENT_LOCAL_PORT=8765

# Ancien préfixe, toujours lu : LOCAL_CHAT_DATA_DIR, LOCAL_CHAT_PORT, LOCAL_CHAT_MOCK, LOCAL_CHAT_MODELS_DIR

# Clé OpenRouter, utilisée seulement par les modèles "openrouter" de models.examples.yaml.
OPENROUTER_API_KEY=
